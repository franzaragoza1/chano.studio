# Copy this file to .env.local for local development and fill in real values.
# In production these variables are set in the Netlify dashboard
# (Site configuration > Environment variables). Never commit real values.

# --- SMTP (Gomailify, domain chano.studio) ---
# Used by the contact form (/api/contact) and the order form (/api/order).
# Port 587 uses STARTTLS; port 465 uses implicit TLS (detected automatically).
EMAIL_HOST=
EMAIL_PORT=587
# Mailbox that authenticates and sends the emails (also used as the "From" address)
EMAIL_USER=
EMAIL_PASS=
# Inbox that receives form submissions (defaults to info@chano.studio if empty)
EMAIL_TO=

# --- Upstash Redis (portfolio edited from /admin) ---
# REST URL and token from the Upstash console. The KV_REST_API_URL /
# KV_REST_API_TOKEN names (Vercel KV integration) are also accepted.
# Without Redis, the portfolio is read from data/portfolio.json and /admin
# can only save changes when running locally (npm run dev).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Admin panel (/admin) ---
# Required: if empty, nobody can save changes from /admin.
ADMIN_PASSWORD=
